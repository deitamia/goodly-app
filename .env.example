# ==============================================================================
# Goodly Local Environment Template (.env.example)
#
# Target: Windows Local Development + Supabase Free Tier
# Copy this file to .env.local and fill in your Supabase project credentials.
# ==============================================================================

# Local Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Free Tier Configuration (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# PostgreSQL Direct Connection String (from Supabase Dashboard -> Project Settings -> Database)
# Used by Drizzle ORM for schema push, migrations, and server-side queries
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres

# Media Storage & Upload Constraints (10 MB per image)
MAX_IMAGE_UPLOAD_BYTES=10485760
SUPABASE_STORAGE_BUCKET_LISTINGS=listing-images
SUPABASE_STORAGE_BUCKET_PROFILES=profile-photos

# Translation Service Engine (Synchronous single attempt, max 5s)
# Providers: mock (default for rapid local development), gemini, google, deepl
TRANSLATION_PROVIDER=mock
GEMINI_API_KEY=
TRANSLATION_TIMEOUT_MS=5000

# Administrator Bootstrap
ADMIN_INITIAL_EMAIL=pavel@example.com
